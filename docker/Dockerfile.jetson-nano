# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.jetson — Jetson Nano (DEPRECATED)
#
# ⚠️  ESTE DOCKERFILE É APENAS PARA JETSON NANO (JetPack 4.6.x, L4T R32.7.x)
# 
# Para Jetson Orin, use: Dockerfile.jetson-orin (L4T R36.x, JetPack 6.x)
# Para Desktop, use: Dockerfile.legion (CUDA 12.1+)
# ─────────────────────────────────────────────────────────────────────────────
FROM nvcr.io/nvidia/l4t-pytorch:r32.7.1-pth1.10-py3

WORKDIR /app

# ⚠️ CRÍTICO: Usar python3 NATIVO da imagem base, não instalar python3.8
# Instalar python3.8 via apt-get quebra os links do torch CUDA na imagem base!
# A imagem base já vem com python3 + PyTorch 1.10 com CUDA 10.2

# ── Dependências da aplicação ────────────────────────────────────────────────
# 🔍 CRÍTICO para CUDA: usar requirements-jetson-nano.txt com versões pinadas
# que funcionam com PyTorch 1.10 e Python 3.6
COPY requirements-jetson-nano.txt .
COPY setup_jetson_nano.sh .

# Instalar curl e build tools (necessário para rustup e compilação)
RUN rm -f /etc/apt/sources.list.d/*.list && \
    sed -i '/apt.kitware.com/d' /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    build-essential && \
    rm -rf /var/lib/apt/lists/*

# Instalar Rust via rustup (necessário para compilar tokenizers)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y && \
    . $HOME/.cargo/env && \
    rustc --version && cargo --version

# Atualizar pip e wheel
RUN python3 -m pip install --upgrade pip wheel

# Instalar dependências
# Tenta --only-binary primeiro (mais rápido), fallback para build com Rust se necessário
RUN python3 -m pip install --no-cache-dir --only-binary :all: -r requirements-jetson-nano.txt || \
    (export PATH="$HOME/.cargo/bin:$PATH" && python3 -m pip install --no-cache-dir -r requirements-jetson-nano.txt)

# Verificar que CUDA está disponível (falhar build se não estiver)
RUN python3 -c "\
import torch; \
print(f'torch version: {torch.__version__}'); \
print(f'CUDA version: {torch.version.cuda}'); \
print(f'CUDA device: {torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"NOT AVAILABLE\"}'); \
assert torch.cuda.is_available(), 'CUDA is not available!'; \
print('✓ CUDA verified in image')"

# ── Aplicação ────────────────────────────────────────────────────────────────
COPY app/ ./app/
COPY data/ ./data/
COPY tests/ ./tests/

RUN mkdir -p logs data/uploads

EXPOSE 8000

ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/app/models/cache
# Expõe a GPU para o container no nvidia-container-runtime (JetPack 4.6)
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
# 🎯 CRÍTICO: Set environment explicitly for hostname-less Docker
ENV AR_ENVIRONMENT=jetson-nano

CMD ["python3", "-m", "uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
